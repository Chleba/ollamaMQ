# ollamaMQ central configuration
#
# Three sections: backends (what to connect to), settings (runtime options)
# and models (what to load where via the model-control load/unload logic).
#
# CLI flags always win when explicitly given:
#   --backend-urls overrides `backends`
#   --port / --host / --timeout / --load-keep-alive / --allow-all-routes
#     override `settings`
#
# The models section is applied automatically at startup (once backends are
# probed) and whenever you press 'r' in the TUI. Applying is additive: each
# endpoint is checked live first, so models that are already resident on a
# target backend — e.g. still loaded from an earlier run because of long
# keep_alive — are skipped instead of being loaded twice. It never unloads
# anything. A backend won't accept a load while it is serving requests, so
# each entry waits (up to 5 minutes) for that backend to go idle first.

# --- Backends ollamaMQ connects to (same as --backend-urls) -----------------
# Each entry is either a plain URL, or an object with `url` plus an optional
# `token`. The token is sent to that backend as `Authorization: Bearer <token>`
# on every request the proxy makes to it — proxied inference, model listings,
# health probes and model load/unload. A client's own Authorization header is
# always forwarded untouched (the token only fills in when none was provided).
backends:
  - http://10.137.1.1:11434        # Ollama — no auth needed
  - url: http://10.137.1.2:11434   # object form, e.g. for a backend behind an
    token: "some-api-key"          #   authenticated reverse proxy (LM Studio, vLLM, ...)
  - http://10.137.1.5:1234         # LM Studio

# --- Runtime settings -------------------------------------------------------
settings:
  port: 11435                  # proxy listen port          (default 11435)
  host: 127.0.0.1              # bind interface             (default 127.0.0.1)
  timeout: 300                 # request timeout, seconds   (default 300)
  load_keep_alive: 86400       # model-control keep_alive   (default 86400 = 24 h)
  allow_all_routes: false      # fallback proxy for unknown routes (default false)
  stuck_timeout: 60            # fail-fast 503 after N s when no backend can ever
                               # serve a queued request (default 60; requests merely
                               # waiting for a busy/loading backend are exempt)
  max_concurrent_per_backend: 1  # global cap of in-flight requests per backend
                                 # (default 1 = one at a time, the historical behavior;
                                 # raise it to let one backend serve several requests
                                 # concurrently, bounded per model by
                                 # models[].max_concurrent_requests).
                                 # Metadata reads (/api/tags, /api/ps, /api/show,
                                 # /v1/models, /api/version, /) are exempt: they run no
                                 # inference, so they never wait for a slot or take one.
  max_body_bytes: 67108864     # largest request body accepted; 413 beyond it (default 64 MiB).
                               # Bodies are buffered whole while a request waits for a backend,
                               # so this is the per-request memory commitment.
                               # /api/blobs/{digest} keeps its own 1 GiB allowance for model layers.
  max_queued_bytes: 536870912  # total bytes of request bodies waiting in all queues; 503 beyond it
                               # (default 512 MiB). A request is always admitted when the queues are
                               # empty, so one oversized body can never stall the proxy.
  request_log_path: ollamamq-requests.jsonl   # request/response JSONL log file (default shown)
  request_log_max_bytes: 10485760             # rotate when file exceeds this (default 10 MiB)
  request_log_max_files: 5                    # rotated files kept as .0 .1 ... (default 5)
  log_content_limit: 65536                    # max body bytes captured per record, min 1024 (default 64 KiB)

# --- Models to load onto backends -------------------------------------------
# Fields per model:
#   name                     model name as the backend knows it (smart-matched:
#                            ':latest' / case-insensitive / unique substring)
#   identifier               label attached to the load op (shown in TUI + admin API)
#   max_ctx                  max context window (Ollama num_ctx / LM Studio context_length)
#   keep_alive               seconds to stay resident after load (Ollama only;
#                            default: settings.load_keep_alive; -1 = forever)
#   max_concurrent_requests  max in-flight requests for this model on one backend
#                            (default 1; also bounded by settings.max_concurrent_per_backend).
#                            Keyed on the model's base name, so the same budget applies
#                            however the client spells it: 'qwen3.8-27b',
#                            'qwen/qwen3.8-27b' and 'unsloth/qwen3.8-27b@q8_0' all count
#                            against this one entry.
#   backends                 URLs to load on — EVERY backend whose URL contains the
#                            string is targeted, so '- :11434' covers all backends on
#                            that port. A non-empty list ALSO pins routing: requests
#                            for this model only go to these backends, and fail with
#                            503 after stuck_timeout if none of them can serve.
#                            Empty/omitted = any suitable backend
models:
  # Big MoE model pinned to two specific backends with a large context
  - name: "gpt-oss:120b"
    identifier: "my-gpt"
    max_ctx: 128000
    keep_alive: 86400
    max_concurrent_requests: 3
    backends:
      - http://10.137.1.1:11434
      - http://10.137.1.2:11434

  # Small coding model available on every connected backend
  - name: "qwen2.5-coder:7b"
    identifier: "coder"
    max_ctx: 32768

  # LM Studio example: 'backends' matches by substring too (and covers every
  # backend whose URL contains it, not just the first)
  - name: "qwen/qwen3.8-27b"
    identifier: "qwen3.8"
    max_ctx: 130000
    backends:
      - 10.137.1.5:1234

# --- Decision-model ("System One") backends: CLM / Laya / Kev ----------------
# A third backend family next to Ollama and OpenAI/LM Studio: servers that
# answer POST /v1/systemone with typed decisions instead of text. They
# implement no /api/* route AT ALL, so the only route proxied to them is
# /v1/systemone (passed through byte-for-byte); /api/chat and
# /v1/chat/completions never reach them. /v1/rank and Kev's
# /v1/systemone/permute|separate are not proxied. Auth on all three is
# `Authorization: Bearer <key>` — exactly what `token:` already sends
# (CLM_API_KEY / LAYA_API_KEY / KEV_API_KEY), so no new auth key exists.
#
# Things that bite here, all different from the Ollama/LM Studio sections:
#   * Model control does not exist for this family: no load/unload, no
#     keep_alive, no /api/ps. Residency is configured on the server itself
#     (LAYA_PRELOAD, LAYA_MAX_LOADED, ...). A models: entry below therefore
#     makes the name ROUTABLE and pins it — it starts no load and waits for no
#     idle backend. /admin/models/load is refused for these backends.
#   * CLM and Kev are auto-detected from GET /v1/models answering
#     {"models":[{"name":…}]} and need nothing extra. Laya exposes no listing
#     endpoint at all, so no probe can identify it — pin it with
#     `kind: systemone` or every request naming a model 503s after
#     stuck_timeout on an unclassified backend.
#   * A name no probe can discover is unroutable unless declared in models:,
#     and a models: entry WITHOUT a `backends:` selector is admitted on EVERY
#     backend — so the selector below is required, not cosmetic.
#   * laya-serve binds 0.0.0.0:8000 and clm-serve binds 0.0.0.0:8700 OPEN BY
#     DEFAULT: anyone on the LAN can run inference. Bind them to loopback
#     (e.g. LAYA_HOST=127.0.0.1) or set their API key. kev.serve binds
#     127.0.0.1:8008 and is not exposed.
#   * clm-serve needs a separate vLLM pooling encoder (default
#     http://127.0.0.1:8090/v1/embeddings) and answers 502 while it is down —
#     that is CLM replying, not the backend being offline.
#
# backends:
#   - url: http://127.0.0.1:8700       # clm-serve — auto-detected: its
#     token: "clm-key"                 #   GET /v1/models is models/name
#   - url: http://127.0.0.1:8000       # laya-serve — nothing to probe, so the
#     token: "laya-key"                #   family has to be pinned by hand
#     kind: systemone
#   - http://127.0.0.1:8008            # kev.serve — auto-detected, no key set
#
# models:
#   # Laya checkpoints: not discoverable, so these entries are what make them
#   # usable at all. Selector points at the Laya backend only.
#   - name: "english"
#     backends:
#       - http://127.0.0.1:8000
#   - name: "multilingual"
#     backends:
#       - http://127.0.0.1:8000
#   - name: "typed-decisions"
#     backends:
#       - http://127.0.0.1:8000
#   # Not needed for CLM/Kev — the probe discovers those names. Declaring one
#   # anyway only makes sense to pin routing or to cap max_concurrent_requests.
#   - name: "clm-latest"
#     backends:
#       - http://127.0.0.1:8700
